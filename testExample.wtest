import entrenadores.*
import disciplinas.*
import elementos.*
import victoria.*

describe "Tests para saber el presupuesto de victoria" {

  test "Victoria se quiere parecer a Pareto (que mide 150 cms), se hace pequeña, practica judo y por lo tanto necesita un traje de judo. Además, tiene 4 entrenadores" {
    victoria.alturaNueva(150)
    victoria.disciplina(judo)
    judo.elemento()
    victoria.entrenadores(4) 
    victoria.costoPorEntrenadores() 
    assert.equals(8780, victoria.presupuesto())
  }

  test "Victoria ahora se quiere parecer a Delpo y empieza a practicar tenis. Elonga con intensidad hasta llegar a los dos metros diez, necesita una raqueta y tiene dos entrenadores."{
    victoria.alturaNueva(210)
    victoria.disciplina(tenis)
    tenis.elemento() 
    victoria.entrenadores(2) 
    victoria.costoPorEntrenadores() 
    assert.equals(3115, victoria.presupuesto()) 
  }

  test "Victoria practica hockey, nmecesita un palo de hockey y tiene 3 entrenadores"{
    victoria.disciplina(hockey)
    hockey.elemento()
    victoria.entrenadores(3) 
    victoria.costoPorEntrenadores() 
    assert.equals(3600, victoria.presupuesto()) 
  }

}